# Base URL of the npmgraph HTTP API the app talks to.
# Include the trailing /api. Falls back to the project's ngrok tunnel if unset.
#
# Local dev against docker compose on your machine:
#   EXPO_PUBLIC_API_BASE=http://<your-LAN-ip>:8091/api
# Public tunnel (phone on a different network):
#   EXPO_PUBLIC_API_BASE=https://<your-ngrok-domain>.ngrok-free.dev/api
EXPO_PUBLIC_API_BASE=
