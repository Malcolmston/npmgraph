tag-version-prefix=v
strict-peer-dependencies=false
auto-install-peers=true

# Parcel resolves plugins from .parcelrc at the project root, so its packages
# (and their default-config plugins) must be hoisted to the top-level node_modules.
public-hoist-pattern[]=*parcel*
public-hoist-pattern[]=@parcel/*
public-hoist-pattern[]=@swc/*
public-hoist-pattern[]=lightningcss*
