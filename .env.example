# Bugsnag API key for error reporting
BUGSNAG_KEY=
# ngrok tunnel (docker compose `ngrok` service) — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# ngrok reserved static domain, e.g. my-app.ngrok-free.dev — pins the public URL
# across restarts. Free accounts get one at https://dashboard.ngrok.com/domains
NGROK_DOMAIN=
# Neo4j password used by the `graph` compose profile
NEO4J_PASSWORD=npmgraph123
# Neo4j AuraDB connection (used by the api/mcp services). Leave blank to use the
# local `neo4j` container. Format: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# Default package served at the /mcp root
DEFAULT_PACKAGE=express
