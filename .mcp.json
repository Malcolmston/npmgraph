{
  "mcpServers": {
    "npmgraph": {
      "command": "node",
      "args": ["mcp/dist/index.js"],
      "env": {
        "NEO4J_URI": "${NEO4J_URI:-neo4j://localhost:7687}",
        "NEO4J_USER": "${NEO4J_USER:-neo4j}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD:-npmgraph123}"
      }
    }
  }
}
